<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="hellofxmysql.ConnectionController" stylesheets="@styles.css"
      prefHeight="480.0" prefWidth="420.0" fx:id="rootPane">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0"/>
    </padding>

    <Label text="Conexión MySQL" styleClass="title"/>

    <VBox spacing="5.0">
        <Label text="Host"/>
        <TextField fx:id="txtHost" promptText="localhost o IP del servidor"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Puerto"/>
        <TextField fx:id="txtPort" promptText="3306"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Base de datos"/>
        <TextField fx:id="txtDatabase" promptText="nombre de la BD"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Usuario MySQL"/>
        <TextField fx:id="txtUser" promptText="usuario de la BD"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Contraseña MySQL"/>
        <PasswordField fx:id="txtPassword" promptText="contraseña de la BD"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Guardar" onAction="#onSaveClick" styleClass="button"/>
        <Button text="Probar" onAction="#onTestClick" styleClass="button, button-secondary"/>
        <Button text="Volver" onAction="#onBackClick" styleClass="button, button-secondary"/>
    </HBox>
</VBox>
