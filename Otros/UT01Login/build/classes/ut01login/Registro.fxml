<?xml version="1.0" encoding="UTF-8"?>

<!--
================================================================================
 VISTA DE REGISTRO
================================================================================
 Igual que FXML.fxml:
   fx:controller="ut01login.RegistroController"  -> su controlador
   stylesheets="@estilos.css"                    -> MISMO CSS que el login

 Diferencia: aquí no se usan coordenadas (layoutX/Y), sino paneles que
 colocan solos a sus hijos (StackPane + VBox + HBox). Es más cómodo porque
 todo queda centrado aunque la ventana cambie de tamaño.
================================================================================
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane: apila los hijos uno encima de otro y los CENTRA.
     Como solo tiene un hijo (el VBox), sirve para centrar la "tarjeta". -->
<StackPane prefHeight="400.0"
           prefWidth="600.0"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ut01login.RegistroController"
           stylesheets="@estilos.css">

    <children>
        <!-- La "tarjeta" blanca del formulario.
             styleClass="form-card" -> fondo blanco y bordes redondeados (CSS).
             alignment="CENTER" centra los hijos dentro del VBox.
             maxWidth evita que el VBox se estire a todo el ancho. -->
        <VBox alignment="CENTER"
              maxWidth="390.0"
              spacing="16.0"
              styleClass="form-card">

            <!-- padding = espacio INTERIOR (margin sería exterior) -->
            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <children>
                <Label text="Nuevo registro"
                       styleClass="titulo"/>

                <Label text="Crea tu cuenta para continuar"
                       styleClass="subtitulo"/>

                <!-- fx:id debe coincidir con el atributo @FXML del controlador -->
                <TextField fx:id="tfUsuario"
                           promptText="Nombre de usuario"
                           maxWidth="300.0"/>

                <PasswordField fx:id="pfContrasena"
                               promptText="Contraseña"
                               maxWidth="300.0"/>

                <PasswordField fx:id="pfConfirmacion"
                               promptText="Repetir contraseña"
                               maxWidth="300.0"/>

                <!-- Los dos botones en horizontal y centrados -->
                <HBox alignment="CENTER"
                      spacing="12.0">

                    <children>
                        <Button fx:id="btnRegistrar"
                                text="Registrarse"/>

                        <Button fx:id="btnVolver"
                                text="Volver"
                                styleClass="boton-secundario"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
