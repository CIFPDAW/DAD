<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="ap1"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="400.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ut01login.FXMLController"
            stylesheets="@estilos.css">

    <children>

        <Label text="Iniciar sesión"
               layoutX="0.0"
               layoutY="45.0"
               prefWidth="600.0"
               alignment="CENTER"
               styleClass="titulo"/>

        <VBox fx:id="vbox1"
              layoutX="89.0"
              layoutY="128.0"
              prefHeight="72.0"
              prefWidth="409.0"
              spacing="20.0">

            <children>
                <TextField fx:id="tf1"
                           promptText="Usuario" />

                <PasswordField fx:id="pf1"
                               promptText="Contraseña" />
            </children>
        </VBox>

        <HBox fx:id="hbox1"
              layoutX="120.0"
              layoutY="213.0"
              prefHeight="100.0"
              prefWidth="360.0">

            <children>
                <Button fx:id="button1"
                        mnemonicParsing="false"
                        text="Acceder">
                    <HBox.margin>
                        <Insets left="35.0" top="30.0" />
                    </HBox.margin>
                </Button>

                <Button fx:id="button2"
                        mnemonicParsing="false"
                        text="Nuevo registro">
                    <HBox.margin>
                        <Insets left="15.0" top="30.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <Button fx:id="button3"
                layoutX="240.0"
                layoutY="320.0"
                mnemonicParsing="false"
                text="Configurar BD"
                styleClass="boton-secundario" />

        <Label fx:id="label1"
               layoutX="54.0"
               layoutY="355.0"
               text=""
               visible="false" />

    </children>
</AnchorPane>
