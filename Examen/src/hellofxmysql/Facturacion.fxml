<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0"
           prefWidth="600.0"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="hellofxmysql.FacturacionController"
           stylesheets="@estilos.css">

    <children>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
        <VBox alignment="CENTER"
              maxWidth="420.0"
              spacing="16.0"
              styleClass="form-card">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <children>
                <Label text="Taller mecánico"
                       styleClass="titulo"/>

                <Label text="Sistema de facturación rápida"
                       styleClass="subtitulo"/>

                <Label fx:id="lblEmpleado"
                       text=""
                       styleClass="subtitulo"/>

                <Separator maxWidth="360.0"/>

                <Label text="Datos del cliente"
                       styleClass="seccion"/>

                <TextField fx:id="tfNombreCliente"
                           promptText="Nombre del cliente"
                           maxWidth="360.0"/>

                <TextField fx:id="tfDni"
                           promptText="DNI / NIF"
                           maxWidth="360.0"/>

                <TextField fx:id="tfMatricula"
                           promptText="Matrícula del vehículo"
                           maxWidth="360.0"/>

                <TextField fx:id="tfTelefono"
                           promptText="Teléfono"
                           maxWidth="360.0"/>

                <Separator maxWidth="360.0"/>

                <Label text="Servicios de mantenimiento"
                       styleClass="seccion"/>

                <VBox spacing="10.0" maxWidth="360.0">
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbCambioAceite"
                                          text="Cambio de aceite"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioAceite"
                                       text="45.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbFiltroAceite"
                                          text="Filtro de aceite"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioFiltroAceite"
                                       text="18.50 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbFiltroAire"
                                          text="Filtro de aire"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioFiltroAire"
                                       text="22.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbPastillasFreno"
                                          text="Pastillas de freno"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioPastillasFreno"
                                       text="95.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbAlineacion"
                                          text="Alineación y balanceo"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioAlineacion"
                                       text="65.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbRevisionNeumaticos"
                                          text="Revisión de neumáticos"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioRevisionNeumaticos"
                                       text="30.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbRevisionFrenos"
                                          text="Revisión sistema de frenos"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioRevisionFrenos"
                                       text="40.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="cbDiagnostico"
                                          text="Diagnóstico electrónico"
                                          prefWidth="280.0"/>
                                <Label fx:id="lblPrecioDiagnostico"
                                       text="55.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Separator maxWidth="360.0"/>

                <VBox spacing="8.0" maxWidth="360.0" alignment="CENTER_RIGHT">
                    <children>
                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <children>
                                <Label text="Total servicios:"
                                       styleClass="etiqueta"/>
                                <Label fx:id="lblTotalServicios"
                                       text="0.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <children>
                                <Label text="I.G.I.C. (7%):"
                                       styleClass="etiqueta"/>
                                <Label fx:id="lblIGIC"
                                       text="0.00 €"
                                       styleClass="precio"/>
                            </children>
                        </HBox>

                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <children>
                                <Label text="TOTAL:"
                                       styleClass="total-label"/>
                                <Label fx:id="lblTotal"
                                       text="0.00 €"
                                       styleClass="total-valor"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER"
                      spacing="12.0">
                    <children>
                        <Button fx:id="btnGenerar"
                                text="Generar factura"/>

                        <Button fx:id="btnLimpiar"
                                text="Limpiar"
                                styleClass="boton-secundario"/>
                    </children>
                </HBox>
            </children>
        </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>
